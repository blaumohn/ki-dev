{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-dev.local/schemas/flow_spec.json",
  "title": "ki-dev Fachart: flow_spec",
  "description": "Zustandsablauf / Prozessfluss (bootstrap-notes.de.md Abschnitt 8/10).",
  "type": "object",
  "required": ["fachart", "kennung", "titel", "zustand", "beschreibung", "schritte"],
  "additionalProperties": false,
  "properties": {
    "fachart": { "const": "flow_spec" },
    "kennung": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "titel": { "type": "string", "minLength": 1 },
    "zustand": { "enum": ["entwurf", "aktiv", "abgeloest", "verworfen"] },
    "beschreibung": { "type": "string", "minLength": 1 },
    "schritte": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "typ", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Lokale Unterkennung, eindeutig innerhalb dieses Dokuments."
          },
          "typ": { "enum": ["start", "zustand", "ereignis", "ende"] },
          "name": { "type": "string", "minLength": 1 },
          "beschreibung": { "type": "string" },
          "naechste": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            },
            "description": "Lokale Unterkennungen der Folgeschritte innerhalb dieses Dokuments."
          }
        }
      }
    }
  }
}
