{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-dev.local/schemas/test_matrix.json",
  "title": "ki-dev Fachart: test_matrix",
  "description": "Zuordnung Zustandsmaschinen-/Fachanforderungen zu Tests (bootstrap-notes.de.md Abschnitt 8/10).",
  "type": "object",
  "required": ["fachart", "kennung", "titel", "zustand", "eintraege"],
  "additionalProperties": false,
  "properties": {
    "fachart": { "const": "test_matrix" },
    "kennung": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "titel": { "type": "string", "minLength": 1 },
    "zustand": { "enum": ["entwurf", "aktiv", "abgeloest", "verworfen"] },
    "eintraege": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "anforderung", "bezug_kennung", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Lokale Unterkennung, eindeutig innerhalb dieses Dokuments."
          },
          "anforderung": { "type": "string", "minLength": 1 },
          "bezug_kennung": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Kennung der referenzierten Spezifikation/Anforderung (Existenz wird erst von ki-dev check geprueft)."
          },
          "status": { "enum": ["offen", "in_arbeit", "erfuellt"] },
          "test_pfad": {
            "type": "string",
            "minLength": 1,
            "description": "Quelltext-/Testpfad als Beleg, sofern behauptet (Existenz wird erst von ki-dev check geprueft)."
          }
        }
      }
    }
  }
}
