{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ki-dev.local/schemas/guideline.json",
  "title": "ki-dev Fachart: guideline",
  "description": "Verbindliche Regel mit Geltungsbereich.",
  "type": "object",
  "required": ["fachart", "kennung", "titel", "zustand", "regel", "begruendung", "geltungsbereich"],
  "additionalProperties": false,
  "properties": {
    "fachart": { "const": "guideline" },
    "kennung": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "titel": { "type": "string", "minLength": 1 },
    "zustand": { "enum": ["entwurf", "aktiv", "abgeloest", "verworfen"] },
    "regel": { "type": "string", "minLength": 1 },
    "begruendung": { "type": "string", "minLength": 1 },
    "geltungsbereich": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "beschreibung"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "description": "Lokale Unterkennung, eindeutig innerhalb dieses Dokuments."
          },
          "beschreibung": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
