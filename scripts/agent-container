#!/usr/bin/env bash
# Builds and starts the agent sandbox from the host; see
# docker/agent/README.md.
set -euo pipefail

# shellcheck source=lib/agent-container-mounts.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/agent-container-mounts.sh"
# shellcheck source=lib/agent-container-workdir.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib/agent-container-workdir.sh"

main() {
  refuse_inside_container
  repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
  image_name="${KI_DEV_AGENT_IMAGE:-ki-dev-agent:local}"
  volume_key="$(printf '%s' "$repo_dir" | cksum | cut -d ' ' -f 1)"
  mount_dir="${XDG_CONFIG_HOME:-$HOME/.config}/ki-dev/agent-container/mounts"
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-container"
  compose_files=(-f "$repo_dir/compose.yaml")
  mount_files=()
  ro_sources=()
  env_names=()
  run_args=()
  workdir=""
  container_name=""
  mode=dev
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        print_help
        exit 0
        ;;
      -m | --mount)
        if [[ $# -lt 2 ]]; then usage_error "$1 needs NAME[,NAME...]"; fi
        add_mounts "$2"
        shift 2
        ;;
      --mount=*)
        add_mounts "${1#--mount=}"
        shift
        ;;
      --mount-ro)
        if [[ $# -lt 2 ]]; then usage_error "$1 benötigt DIR"; fi
        add_ro_mount "$2"
        shift 2
        ;;
      --mount-ro=*)
        add_ro_mount "${1#--mount-ro=}"
        shift
        ;;
      --fresh)
        mode="test"
        shift
        ;;
      --workdir)
        if [[ $# -lt 2 ]]; then usage_error "$1 benötigt DIR"; fi
        set_workdir "$2"
        shift 2
        ;;
      --name)
        if [[ $# -lt 2 ]]; then usage_error "$1 benötigt NAME"; fi
        container_name="$2"
        shift 2
        ;;
      --env)
        if [[ $# -lt 2 ]]; then usage_error "$1 benötigt NAME"; fi
        env_names+=("$2")
        shift 2
        ;;
      -*) usage_error "unknown option '$1'" ;;
      *) break ;;
    esac
  done
  if [[ ${#ro_sources[@]} -gt 0 && "${1:-shell}" != shell && "$1" != run ]]; then
    usage_error "--mount-ro gilt nur für shell und run"
  fi
  if [[ $mode == test && "${1:-shell}" != shell && "$1" != run ]]; then
    usage_error "--fresh applies only to shell and run"
  fi
  if [[ -n "$workdir$container_name${env_names[*]:-}" && "${1:-shell}" != shell && "$1" != run ]]; then
    usage_error "--workdir, --name und --env gelten nur für shell und run"
  fi
  case "${1:-shell}" in
    build) build_image ;;
    mounts) list_mounts ;;
    reset) reset_volumes ;;
    stop)
      shift
      stop_container "$@"
      ;;
    shell)
      shift "$(( $# > 0 ? 1 : 0 ))"
      run_agent bash "$@"
      ;;
    run)
      shift
      if [[ $# == 0 ]]; then usage_error "run requires a command"; fi
      run_agent "$@"
      ;;
    *) usage_error "unknown command '$1'" ;;
  esac
}

print_help() {
  cat <<EOF
Usage: scripts/agent-container [OPTION]... [shell [ARGS...]]
       scripts/agent-container [OPTION]... run COMMAND [ARGS...]
       scripts/agent-container [OPTION]... reset
       scripts/agent-container build | mounts | stop NAME

Build the agent image or start the agent sandbox from the host.
Without a command, shell starts bash in the sandbox; mounts lists the
names usable with --mount; stop removes a named container. reset removes the home and venv volumes of
this checkout and the dependency volumes of the repos chosen with --mount.

Options:
  -m, --mount NAME[,NAME...]  also apply the mount file NAME.yaml;
                              repeatable, unique prefixes are accepted
      --mount-ro DIR          vorhandenen Ordner schreibgeschützt unter
                              /references/<Ordnername> einbinden; wiederholbar
      --fresh                 test mode: temporary home, venv, dependency
                              directories and Go build cache
      --workdir DIR           nur diesen Git-Worktree unter gleichem Pfad
                              einbinden, Hauptcheckout nicht
      --name NAME             Containername, für stop NAME
      --env NAME              Variable NAME der aufrufenden Umgebung
                              weitergeben; wiederholbar
  -h, --help                  show this help and exit

Download caches: \${XDG_CACHE_HOME:-~/.cache}/agent-container

Mount files: \${XDG_CONFIG_HOME:-~/.config}/ki-dev/agent-container/mounts/NAME.yaml
Template:    docker/agent/mount.example.yaml

../beads is always mounted at /beads when present; KI_DEV_AGENT_BEADS_REPO
selects another checkout. If .beads/config.yaml uses lint.max-chars, its
.build/linux/bd is required. Details: docker/agent/README.md
EOF
}

usage_error() {
  echo "agent-container: $1" >&2
  echo "Try 'scripts/agent-container --help' for more information." >&2
  exit 2
}

refuse_inside_container() {
  if [[ "${KI_DEV_AGENT_CONTAINER:-}" == "1" ]]; then
    echo "scripts/agent-container starts the Docker sandbox from the host and needs" >&2
    echo "Docker; it neither has nor needs a Docker socket inside that sandbox." >&2
    echo "You are already running inside the agent container, so run the target" >&2
    echo "command directly instead, e.g.:" >&2
    echo "  bd prime" >&2
    echo "  ./.venv/bin/python -m pytest" >&2
    exit 1
  fi
}

build_image() {
  require_buildx
  local build_args_text argument
  local build_args=()
  build_args_text="$(tool_version_build_args)"
  while IFS= read -r argument; do
    build_args+=("$argument")
  done <<< "$build_args_text"
  # Global: the EXIT trap runs after this function has returned.
  build_context="$(mktemp -d)"
  trap 'rm -rf -- "$build_context"' EXIT
  copy_build_sources
  # --load: a docker-container builder would otherwise keep the result in
  # its cache only, and shell/run would start the previous image.
  docker buildx build --load "${build_args[@]}" --build-arg "AGENT_UID=$(id -u)" --build-arg "AGENT_GID=$(id -g)" \
    -t "$image_name" -f "$build_context/docker/agent/Dockerfile" "$build_context"
}

# The Dockerfile needs BuildKit (cache mounts); plain docker build may
# silently fall back to the legacy builder when buildx is missing.
require_buildx() {
  if ! docker buildx version >/dev/null 2>&1; then
    echo "docker buildx is missing; install it (e.g. brew install docker-buildx)" >&2
    echo "and register the plugin dir via cliPluginsExtraDirs in ~/.docker/config.json." >&2
    exit 1
  fi
}

# Image and tool versions from the shared source, one --build-arg per pair.
tool_version_build_args() {
  host_python -m ki_dev.tool_versions
}

host_python() {
  local python="$repo_dir/.venv/bin/python"
  if [[ ! -x "$python" ]]; then
    # Hosts without the project venv may use Python 3 with jsonschema
    # (docker/agent/README.md).
    python=python3
  fi
  PYTHONPATH="$repo_dir/src" "$python" "$@"
}

# Only the sources the image needs, so unrelated changes keep the layer cache.
copy_build_sources() {
  mkdir -p "$build_context/project" "$build_context/docker"
  cp "$repo_dir/pyproject.toml" "$build_context/project/"
  cp -R "$repo_dir/src" "$build_context/project/"
  cp -R "$repo_dir/docker/agent" "$build_context/docker/"
  # COPY keeps modes; a checkout with private files (0600) would give an image
  # whose entrypoint the agent user cannot read.
  chmod -R u+rwX,go+rX-w "$build_context"
}

run_agent() {
  # Reuse the user's existing CLI logins; no API keys are forwarded.
  local auth_root="${KI_DEV_AGENT_AUTH_HOME:-$HOME}"
  add_dependency_volumes
  require_cli_logins "$auth_root"
  export_compose_env "$auth_root"
  prepare_caches
  if [[ $mode == test ]]; then
    compose_files+=(-f "$repo_dir/compose.fresh.yaml")
  fi
  add_beads_mount
  local guard=() progress=()
  if [[ -n "$workdir" ]]; then
    add_workdir_args
    # Check output is evidence for the review; Compose noise is not.
    progress=(--progress quiet)
    guard=(sh -c "$WORKDIR_GUARD" agent-container)
  fi
  local source name
  for source in ${ro_sources[@]+"${ro_sources[@]}"}; do
    run_args+=(-v "$source:/references/${source##*/}:ro")
  done
  for name in ${env_names[@]+"${env_names[@]}"}; do
    run_args+=(-e "$name")
  done
  if [[ -n "$container_name" ]]; then run_args+=(--name "$container_name"); fi
  if [[ ! -t 0 || ! -t 1 ]]; then run_args+=(-T); fi
  exec docker compose ${progress[@]+"${progress[@]}"} "${compose_files[@]}" -p "ki-dev-agent-$volume_key" \
    run --rm --no-deps ${run_args[@]+"${run_args[@]}"} agent ${guard[@]+"${guard[@]}"} "$@"
}

# x-ki-dev of the chosen mount files becomes a Compose file for the
# dependency directories; an invalid contract exits 2 before Docker starts.
# The file name carries this PID, which exec hands on to docker compose, so
# files of finished runs can be removed on the next start.
add_dependency_volumes() {
  if [[ ${#mount_files[@]} == 0 ]]; then return; fi
  local overlay_dir="$cache_dir/compose"
  local overlay="$overlay_dir/deps-$$.json"
  remove_stale_overlays "$overlay_dir"
  host_python -m ki_dev.agent_dev_volumes --mode "$mode" \
    --uid "$(id -u)" --gid "$(id -g)" \
    --project-directory "$repo_dir" "${mount_files[@]}" > "$overlay"
  compose_files+=(-f "$overlay")
}

remove_stale_overlays() {
  local overlay_dir="$1" overlay pid
  mkdir -p "$overlay_dir"
  for overlay in "$overlay_dir"/deps-*.json; do
    if [[ ! -f "$overlay" ]]; then continue; fi
    pid="${overlay##*/deps-}"
    pid="${pid%.json}"
    if ! kill -0 "$pid" 2>/dev/null; then rm -f -- "$overlay"; fi
  done
}

require_cli_logins() {
  local auth_root="$1" auth_dir
  for auth_dir in .claude .codex .gemini; do
    if [[ ! -d "$auth_root/$auth_dir" ]]; then
      echo "Missing $auth_root/$auth_dir; log in with the CLI on the host first." >&2
      exit 1
    fi
  done
}

export_compose_env() {
  local auth_root="$1"
  export KI_DEV_AGENT_REPO="$repo_dir"
  export KI_DEV_AGENT_IMAGE="$image_name"
  export KI_DEV_AGENT_AUTH_HOME="$auth_root"
  export KI_DEV_AGENT_HOME_VOLUME="ki-dev-agent-${volume_key}-home"
  export KI_DEV_AGENT_VENV_VOLUME="ki-dev-agent-${volume_key}-venv"
  # Optional host state; without it compose.yaml mounts /dev/null.
  unset KI_DEV_CLAUDE_STATE
  if [[ -f "$auth_root/.claude.json" ]]; then
    export KI_DEV_CLAUDE_STATE="$auth_root/.claude.json"
  fi
}

# Host folders of the caches bound in compose.yaml; created here, otherwise
# Docker would create them as root.
prepare_caches() {
  export KI_DEV_AGENT_CACHE_DIR="$cache_dir"
  mkdir -p "$cache_dir"/{npm,pip,go-mod,go-build}
}

# Optional beads checkout for Go development and local bd builds, mounted at
# /beads whenever ../beads exists or KI_DEV_AGENT_BEADS_REPO is set.
add_beads_mount() {
  local beads_home="${target_repo:-$repo_dir}"
  if [[ -z "${KI_DEV_AGENT_BEADS_REPO:-}" && -d "$beads_home/../beads" ]]; then
    KI_DEV_AGENT_BEADS_REPO="$(cd -- "$beads_home/../beads" && pwd)"
  fi
  if [[ -n "${KI_DEV_AGENT_BEADS_REPO:-}" ]]; then
    export KI_DEV_AGENT_BEADS_REPO
    exclude_beads_build "$KI_DEV_AGENT_BEADS_REPO"
    compose_files+=(-f "$repo_dir/compose.beads.yaml")
    # The host's bd may live in that checkout; agents must not replace it.
    if [[ -n "$workdir" ]]; then
      run_args+=(-v "$KI_DEV_AGENT_BEADS_REPO:/beads:ro")
    fi
  fi
  require_local_bd "$beads_home"
}

# lint.max-chars exists only in the local bd build (ki-dev-ablauf-qdg); the
# image's bd would ignore it silently. Drop this check once BD_VERSION has it.
require_local_bd() {
  local config="$1/.beads/config.yaml"
  if ! grep -Eq '^[^#]*max-chars' "$config" 2>/dev/null; then return; fi
  local bd="${KI_DEV_AGENT_BEADS_REPO:-../beads}/.build/linux/bd"
  if [[ -z "${KI_DEV_AGENT_BEADS_REPO:-}" || ! -x "$bd" ]]; then
    echo "Missing $bd; .beads/config.yaml uses lint.max-chars, which needs" \
      "a local bd build. Build bd in ../beads or set KI_DEV_AGENT_BEADS_REPO." >&2
    exit 1
  fi
}

# The local bd build lands in /beads/.build/linux; keep it out of git status.
# A checkout without .git has no status to keep clean.
exclude_beads_build() {
  local beads="$1" exclude
  if [[ ! -e "$beads/.git" ]]; then return; fi
  exclude="$(git -C "$beads" rev-parse --path-format=absolute --git-path info/exclude)"
  mkdir -p "$(dirname -- "$exclude")"
  if ! grep -qxF '.build/' "$exclude" 2>/dev/null; then
    echo '.build/' >> "$exclude"
  fi
}

# Home and venv volumes of this checkout and the dependency volumes
# (label ki-dev.repo) of the repos chosen with --mount. Download caches and
# the Go build cache stay.
reset_volumes() {
  local volumes=("ki-dev-agent-${volume_key}-home" "ki-dev-agent-${volume_key}-venv")
  local mount_file name labelled existing volume
  local remove=()
  if [[ ${#mount_files[@]} -gt 0 ]]; then
    for mount_file in "${mount_files[@]}"; do
      name="${mount_file##*/}"
      labelled="$(docker volume ls -q --filter "label=ki-dev.repo=${name%.yaml}")"
      for volume in $labelled; do volumes+=("$volume"); done
    done
  fi
  existing="$(docker volume ls -q)"
  for volume in "${volumes[@]}"; do
    if grep -qxF -- "$volume" <<< "$existing"; then remove+=("$volume"); fi
  done
  if [[ ${#remove[@]} == 0 ]]; then
    echo "No dev volumes to remove."
    return
  fi
  if ! docker volume rm "${remove[@]}"; then
    echo "Stop running agent containers of this checkout and retry." >&2
    exit 1
  fi
}

# exit: bash reads scripts while running; an edit during a long build must not
# make it continue somewhere else in the file.
main "$@"; exit
