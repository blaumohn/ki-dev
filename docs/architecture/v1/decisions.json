        "decision": "BLOCK_START",
        "reason": "ESTIMATE_INVALID"
      },
      {
        "when": "split_required",
        "decision": "BLOCK_START",
        "reason": "SPLIT_REQUIRED"
      },
      {
        "when": "allocation_insufficient",
        "decision": "BLOCK_START",
        "reason": "BUDGET_EXHAUSTED"
      },
      {
        "when": "otherwise",
        "decision": "CONTINUE",
        "reason": "OK"
      }
    ],
    "evaluate_tick": [
