{
  "schema_version": 1,
  "policy_version": "v1/2",
  "semantics": "First match per point; collect other failing reasons in row order, unique. No eval of expressions from configuration. Predicates are fixed implementation functions. Only non-OK failing rows contribute secondary_reasons. See ADR for decision-point lifecycle and evidence binding.",
  "predicates": {
    "allocation_insufficient": "required_call_tokens > min(B-M-R-P-C,call_cap_tokens) or required_call_tokens<=0; resume includes context allocation",
    "sample_discontinuous": "sample.status == MEASUREMENT_DISCONTINUITY",
    "sample_missing_after_grace": "tick/phase only: sample absent/non-OK/no total/no source age unless evaluate_tick and startup_grace_active and elapsed_s<startup_sample_timeout_s; never suppress discontinuity",
    "sample_stale": "sample has source_age_s >= max_measurement_age_s",
    "startup_grace_active": "evaluate_tick only, before first sample of this new call (also after resume), baseline and capability verified; false at admission/phase",
    "tick_budget_reached": "M+R+P+C>B or M>=B or call_measured_tokens>=call_allocation_tokens",
    "phase_budget_reached": "M+R+P+C>B or M>=B or call_measured_tokens>call_allocation_tokens",
    "ledger_conflict": "RECONCILIATION_CONFLICT in budget.flags; disagreement with normalized boolean is INVALID_INPUT",
    "ledger_reconciled": "prior calls reconciled with current evidence or missing final accounting validly conservatively charged; no unresolved reconciliation conflict",
    "call_end_confirmed": "confirmed local process end for last call of completed phase; unknown external effect remains subject to existing guards"
  },
  "tables": {
    "admit_start": [
      {
        "when": "operator_stop",
        "decision": "BLOCK_START",
        "reason": "OPERATOR_STOP"
      },
      {
        "when": "not profile_valid",
